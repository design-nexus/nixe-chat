#!/usr/bin/env bash
set -euo pipefail

libdir="$HOME/.local/lib/nixe-chat/llama.cpp"
app_token="${XDG_CONFIG_HOME:-$HOME/.config}/nixe-chat/huggingface.token"
shared_token="${HF_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/huggingface}/token"
if [[ -s $app_token ]]; then
  HF_TOKEN=$(<"$app_token")
  export HF_TOKEN
elif [[ -z ${HF_TOKEN:-} && -s $shared_token ]]; then
  HF_TOKEN=$(<"$shared_token")
  export HF_TOKEN
fi

models_max=1
idle=-1
settings="${XDG_CONFIG_HOME:-$HOME/.config}/nixe-chat/settings.toml"
if [[ -r $settings ]]; then
  while IFS= read -r line; do
    if [[ $line =~ ^llama_models_max[[:space:]]*=[[:space:]]*([124]) ]]; then
      models_max=${BASH_REMATCH[1]}
    elif [[ $line =~ ^llama_idle_seconds[[:space:]]*=[[:space:]]*(-1|300|900|3600) ]]; then
      idle=${BASH_REMATCH[1]}
    fi
  done < "$settings"
fi
exec "$libdir/llama-server" --models-max "$models_max" --sleep-idle-seconds "$idle" "$@"
