[Unit]
Description=Nyx Chat llama.cpp model server (PrismML)
After=network-online.target

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=%h/.local/lib/nyx-chat/llama.cpp
ExecStart=%h/.local/lib/nyx-chat/llama.cpp/llama-server-launch --host 127.0.0.1 --port 8080 --jinja --models-preset %h/.config/nyx-chat/llama-models.ini
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
